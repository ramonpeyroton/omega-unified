# ─── Address Autocomplete ──────────────────────────────────────────
# Powered by Photon (Komoot / OpenStreetMap) — 100% free, no API key.
# No configuration needed. The component works out of the box.

# ─── Internal API secret (shared between app + Vercel Functions) ────
# Same value on both sides — NEVER expose this key publicly.
# Server: OMEGA_API_SECRET (checked by requireSecret in each handler)
# Client: VITE_OMEGA_API_SECRET (injected into x-omega-secret header by apiFetch)
OMEGA_API_SECRET=
VITE_OMEGA_API_SECRET=

# ─── Anthropic API Key (Claude — project reports + cost projection) ─
# Server-side only (no VITE_ prefix). Set in Vercel → Settings → Env Vars.
# Remove VITE_ANTHROPIC_KEY if still set — it is no longer used.
ANTHROPIC_KEY=

# ─── Groq API Key (Jarvis chat, Llama 3.3) ─────────────────────────
# Server-side only (no VITE_ prefix). Set in Vercel → Settings → Env Vars.
# Remove VITE_GROQ_API_KEY if still set — it is no longer used.
GROQ_API_KEY=

# ─── Cloudflare R2 (Daily Logs video storage) ──────────────────────
# Videos in the project chat upload direct to R2 via a presigned PUT
# URL (bypasses Vercel's 4.5 MB body cap and Supabase Free's 1 GB
# storage cap). Images and PDFs still go to Supabase Storage.
#
# Setup: dash.cloudflare.com → R2 → create bucket "omega-videos" →
# enable "Public Development URL" → add CORS policy allowing the app
# origins → create Account API Token with Object Read & Write on
# omega-videos → paste the values below and redeploy Vercel.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=omega-videos
# The pub-<hash>.r2.dev base URL from the bucket's Public Development URL.
CLOUDFLARE_R2_PUBLIC_URL=

# ─── DocuSign (client-side, safe to expose) ────────────────────────
# Set VITE_DOCUSIGN_ENABLED=1 once DocuSign is contracted AND the
# server-side credentials below are filled in. Until then the contract
# screen still renders the editable template + Download PDF button —
# only the "Send via DocuSign" action stays disabled.
VITE_DOCUSIGN_ENABLED=
VITE_DOCUSIGN_INTEGRATION_KEY=
VITE_DOCUSIGN_ACCOUNT_ID=
VITE_DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
VITE_DOCUSIGN_REDIRECT_URI=http://localhost:5174/docusign/callback

# ─── DocuSign (server-side — used by Vercel Functions only) ────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.net
# RSA private key from DocuSign App. Keep newlines as real \n.
DOCUSIGN_PRIVATE_KEY=
# Optional: set if DocuSign Connect HMAC signing is enabled
DOCUSIGN_HMAC_SECRET=

# ─── Supabase (server-side — used by the webhook) ──────────────────
SUPABASE_URL=https://jbdtdyxzfejhotbjdnwm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

